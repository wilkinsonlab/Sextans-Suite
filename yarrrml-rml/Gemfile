# frozen_string_literal: true

source "https://rubygems.org"

gem 'sinatra', '>= 4.2.2'
gem "thin"
gem "open3"
gem 'csv'
gem "fileutils"
# Sinatra 4's classic-mode auto-boot needs one of these present to pick a
# handler -- without it, "ruby t.rb" fails with "Sinatra could not start,
# the required gems weren't found!" even though thin is installed.
gem 'rackup'
gem 'puma', '>= 8.1.3'
# Pinned floors for gems flagged by Trivy (CRITICAL/HIGH CVEs fixed at or above
# these versions). rack < 3.2.8 held a full multipart body in memory
# (GHSA-5v64-555j-wjxm, HIGH) and mis-reported a forged Host
# (GHSA-2j8w-xcrc-x985), both reachable before any app code. See the
# RefuseMultipart middleware and :method_override setting in t.rb. puma >= 8.1.3
# and sinatra >= 4.2.2 (which pins rack-protection = 4.2.2, fixing
# GHSA-pf75-2v58-7mxg) are set above. We own this Gemfile just like the
# cde-box-daemon's, so these are patched here too, not merely tracked.
gem 'rack', '>= 3.2.8'
gem 'rack-protection', '>= 4.2.2'

