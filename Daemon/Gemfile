source 'https://rubygems.org'
ruby "3.4.10"


gem 'ffi'

gem 'digest', '~> 3.1'

gem 'puma', '>= 8.0.2'

gem 'linkeddata', '~> 3.3'

gem 'addressable', '>= 2.9'

gem 'json', '~> 2.9'

gem 'rest-client', '~> 2.1'

# Virtuoso's SPARQL-Update/Graph Store write endpoints require real HTTP Digest
# auth and reject Basic auth outright -- rest-client has no Digest support, so
# this is needed purely for the write path to Virtuoso (reads stay on rest-client
# via HTTPUtils, since Virtuoso's plain read endpoint needs no auth).
gem 'net-http-digest_auth', '~> 1.4'

gem "rackup", "~> 2.2"

gem "sinatra", '>= 4.2'

# Pinned floors for transitive deps flagged by Trivy (CRITICAL/HIGH CVEs fixed
# at or above these versions) -- see Sextans/Security/vulnerability-register.csv
gem 'rack', '>= 3.2.6'
gem 'rack-session', '>= 2.1.2'
gem 'nokogiri', '>= 1.19.3'
gem 'concurrent-ruby', '>= 1.3.7'
gem 'rexml', '>= 3.3.9'
gem 'resolv', '>= 0.7.2'
