# AN EXAMPLE .env (DOT env) file for docker-compose
# what the CARE-SM transform will use as the base for all URLs it genereates
# this DOES NOT HAVE TO RESOLVE - these are local identifiers.
baseURI=http://my.domain.org/data/
# user and password with write-permissions on the CDE database
TRIPLESTORE_USER=admin
TRIPLESTORE_PASS=root
# This is used by the Updater - must be active if you use it
# These addresses are from the perspective of the Docker container 
# (i.e. they are docker network addresses, not external URLs)
# DATA_SPARQL_ENDPOINT=http://virtuoso:8890/sparql
# TRIPLESTORE_GRAPH=urn:acme:sextans-fix
# which data model this install transforms into: CARE-SM-2 or FLAIR-GG (see Daemon/models/)
DATA_MODEL=CARE-SM-2
# compose profiles to start: "caresm" for CARE-SM-2 (its Toolkit service); leave empty for FLAIR-GG
COMPOSE_PROFILES=caresm
